{
  "name": "ctf-writeups-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "new": "node scripts/new-challenge.mjs",
    "sync": "node scripts/sync.mjs",
    "dev": "astro dev",
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "build": "astro build",
    "postbuild": "pagefind --site dist && node scripts/check-policy.mjs",
    "refresh": "npm run sync && npm run build",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "pagefind": "^1.3.0"
  }
}
